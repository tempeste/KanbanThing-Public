{
  "id": "kanbanthing-dispatch-protocol",
  "name": "KanbanThing Dispatch Protocol",
  "description": "KanbanThing dispatch lifecycle callbacks and control endpoints for OpenClaw.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kanbanthingTargets": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kanbanthingBaseUrl": {
              "type": "string"
            },
            "kanbanthingApiKey": {
              "type": "string"
            },
            "workspaceIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "callbackPath": {
              "type": "string"
            }
          },
          "required": ["kanbanthingBaseUrl", "kanbanthingApiKey"]
        }
      },
      "workspaceMappingFile": {
        "type": "string"
      },
      "callbackPath": {
        "type": "string"
      },
      "pluginSecret": {
        "type": "string"
      },
      "emitReceivedCallbacks": {
        "type": "boolean"
      },
      "enforceCancellation": {
        "type": "boolean"
      },
      "hardKillMode": {
        "type": "string",
        "enum": ["off", "best_effort", "internal_api"]
      },
      "emitProgressEvents": {
        "type": "boolean"
      },
      "internalApiPathHint": {
        "type": "string"
      }
    },
    "required": []
  }
}
